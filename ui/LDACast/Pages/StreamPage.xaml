<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LDACast.Pages.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12,8,12,8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Stream" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
            <ComboBox
                x:Name="DevicePicker"
                Width="260"
                Header="Device"
                DisplayMemberPath="Name" />
            <ComboBox
                x:Name="CapturePicker"
                Width="220"
                Header="Capture source (blank = default)"
                PlaceholderText="default device"
                IsEditable="True"
                SelectionChanged="CapturePicker_Changed"
                LostFocus="CapturePicker_Changed" />
            <Button
                x:Name="StartBtn"
                VerticalAlignment="Bottom"
                Click="Start_Click"
                Content="Start"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="StopBtn"
                VerticalAlignment="Bottom"
                Click="Stop_Click"
                Content="Stop"
                IsEnabled="False" />
            <Button
                VerticalAlignment="Bottom"
                Click="Safe_Click"
                Content="Load safe parameters"
                ToolTipService.ToolTip="Most compatible: MQ quality, ABR off. Applies on next Start." />
            <Button
                VerticalAlignment="Bottom"
                Click="Sound_Click"
                Content="Sound panel"
                ToolTipService.ToolTip="Windows owns the sample rate: set the capture device to stereo 44.1/48/88.2/96 kHz here, then restart the stream." />
            <CheckBox
                x:Name="FallbackBox"
                VerticalAlignment="Bottom"
                Content="Auto Windows fallback"
                ToolTipService.ToolTip="After a stream existed and the headset drops for 30 s, hand the radio back to Windows (one UAC prompt) and stop."
                Checked="FallbackBox_Changed"
                Unchecked="FallbackBox_Changed" />
            <TextBlock
                x:Name="HintText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="State:" />
                <TextBlock x:Name="StateText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Wire:" />
                <TextBlock x:Name="WireText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Realtime:" />
                <TextBlock x:Name="RtText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Buffer:" />
                <TextBlock x:Name="BufText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CODEC:" />
                <TextBlock x:Name="CodecText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Packets:" />
                <TextBlock x:Name="PacketsText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Over:" />
                <TextBlock x:Name="OverText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Under:" />
                <TextBlock x:Name="UnderText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Quality:" />
                <TextBlock x:Name="QualityText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Encoder:" />
                <TextBlock x:Name="EncoderText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Frames:" />
                <TextBlock x:Name="FramesText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Reconnects:" />
                <TextBlock x:Name="ReconnectsText" FontWeight="SemiBold" Text="-" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="2">
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="Sink: " /><Run x:Name="SinkText" Text="-" />
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="Config: " /><Run x:Name="ConfigText" Text="-" />
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                <Run Text="Capture: " /><Run x:Name="CaptureText" Text="-" />
            </TextBlock>
        </StackPanel>

        <ListView
            x:Name="EventList"
            Grid.Row="4"
            SelectionMode="None" />
    </Grid>
</Page>
